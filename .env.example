# ─────────────────────────────────────────────────────────────
# Telegram Laptop Monitor Bot — Konfigurasi Environment
# Salin file ini: cp .env.example .env  lalu isi nilainya
# ─────────────────────────────────────────────────────────────

# ── WAJIB ────────────────────────────────────────────────────

# Token bot dari @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID yang boleh akses bot
# Single  : CHAT_ID=987654321
# Multiple: CHAT_ID=987654321,111222333
# Multiple: CHAT_ID=987654321|111222333   (alternatif pemisah)
# Cara cek : chat ke @userinfobot di Telegram
CHAT_ID=987654321

# ── SSH (untuk fitur Shutdown & Restart) ─────────────────────

# Path ke SSH private key di dalam container
# Contoh  : /app/ssh/bot_key
# Key ini di-mount dari host via docker-compose volume
SSH_KEY_LOCATION=/app/ssh/bot_key

# Username laptop/host yang dipakai untuk SSH
# Harus sama dengan user yang punya authorized_keys
# Contoh  : eric-tandra
SSH_USER_NAME=eric-tandra
